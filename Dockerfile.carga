FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY backend/requirements-prod.txt backend/requirements-carga.txt /app/
RUN pip install --no-cache-dir -r /app/requirements-carga.txt

COPY backend /app

CMD ["python", "-c", "print('Informe explicitamente o script de carga a executar.')"]
